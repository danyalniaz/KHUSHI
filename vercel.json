{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(store.js|admin-guard.js)",
      "dest": "/$1"
    },
    {
      "src": "/(index.html|shop.html|product-detail.html|cart.html|checkout.html|order-confirmation.html|payment-receipt.html|track-order.html|about.html|contact.html|faq.html|invoice.html|admin-login.html|admin-dashboard.html|admin-products.html|admin-categories.html|admin-orders.html|admin-settings.html|admin-security.html|admin-reports.html)",
      "dest": "/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/admin(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
